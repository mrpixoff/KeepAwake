<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.12"
                    android:text="@string/app_name_upper"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.16"
                    android:text="@string/app_kicker"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/helpButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_card"
                android:contentDescription="@string/help"
                android:src="@drawable/ic_help" />

        </LinearLayout>

        <!-- Hero status block -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:id="@+id/heroOrb"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_hero_orb_idle"
                    android:contentDescription="@string/hero_content" />

                <TextView
                    android:id="@+id/heroStateLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.16"
                    android:text="@string/hero_state_idle"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:text="@string/status_idle"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/timerLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.16"
                android:text="@string/timer_remaining_label"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/timerText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="@string/timer_idle"
                android:textColor="@color/text_primary"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/heroSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/hero_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Auto-off presets -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.16"
                android:text="@string/preset_section"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/radioGroupPresets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/radioIndefinite"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_preset_chip"
                        android:button="@null"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:letterSpacing="0.08"
                        android:minHeight="64dp"
                        android:padding="4dp"
                        android:text="@string/preset_indefinite"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/radio15"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_preset_chip"
                        android:button="@null"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:letterSpacing="0.08"
                        android:minHeight="64dp"
                        android:padding="4dp"
                        android:text="@string/preset_15"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/radio30"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_preset_chip"
                        android:button="@null"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:letterSpacing="0.08"
                        android:minHeight="64dp"
                        android:padding="4dp"
                        android:text="@string/preset_30"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/radio60"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_preset_chip"
                        android:button="@null"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:letterSpacing="0.08"
                        android:minHeight="64dp"
                        android:padding="4dp"
                        android:text="@string/preset_60"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Primary action -->
        <Button
            android:id="@+id/toggleButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_pill_on"
            android:backgroundTint="@null"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:text="@string/toggle_on"
            android:textAllCaps="false"
            android:textColor="@color/on_accent"
            android:textSize="16sp" />

        <!-- Permissions -->
        <LinearLayout
            android:id="@+id/permissionsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.16"
                android:text="@string/permission_section"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/writeSettingsCheck"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_permission_ok"
                    android:contentDescription="@string/ready"
                    android:src="@drawable/ic_check"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.02"
                    android:text="@string/permission_write_settings"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/buttonWriteSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_pill_off"
                    android:backgroundTint="@null"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.06"
                    android:minWidth="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/allow"
                    android:textAllCaps="false"
                    android:textColor="@color/on_stop"
                    android:textSize="12sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/notificationsCheck"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_permission_ok"
                    android:contentDescription="@string/ready"
                    android:src="@drawable/ic_check"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.02"
                    android:text="@string/permission_notifications"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/buttonNotifications"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_pill_off"
                    android:backgroundTint="@null"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.06"
                    android:minWidth="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/allow"
                    android:textAllCaps="false"
                    android:textColor="@color/on_stop"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
